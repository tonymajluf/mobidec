# Deje FileMaker sin configurar para probar el catálogo con datos de demostración.
PORT=3000
NODE_ENV=development
ADMIN_PASSWORD=demo

# Configure todas las variables para activar FileMaker Data API.
FM_BASE_URL=
FM_DATABASE=gmobidec
FM_LAYOUT=Catálogo web
FM_USERNAME=
FM_PASSWORD=
# Use "url" para un campo URL HTTPS editable o "container" para un contenedor FileMaker.
FM_PHOTO_MODE=url

# Opcional: asignar cada propiedad lógica a un nombre de campo de FileMaker.
# Los nombres predeterminados son Tipo, Diseño, Modelo, Descripción, Precio Web y Foto 1.
FM_FIELDS_JSON=
